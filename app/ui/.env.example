# Supabase project URL, for example:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Use one browser-safe key, depending on the Supabase key naming available
# in your project. Do not put service-role keys in Vite env files.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional feature flags can use the VITE_FEATURE_* prefix.
# VITE_FEATURE_GO_SPIKE=false

